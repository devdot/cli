{
    "name": "devdot/cli",
    "description": "Tools for CLI projects, on top of symfony/console.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Devdot\\Cli\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Thomas Kuschan",
            "email": "mail@thomaskuschan.de"
        }
    ],
    "require": {
        "php": "^8.4",
        "psr/container": "^2.0",
        "symfony/config": "^8",
        "symfony/console": "^8",
        "symfony/dependency-injection": "^8",
        "symfony/process": "^8"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12",
        "squizlabs/php_codesniffer": "^4"
    },
    "scripts": {
        "check-static": "phpstan analyse src tests/Traits --level=9",
        "format": "phpcbf --standard=PSR12 src tests",
        "test": "phpunit tests"
    },
    "config": {
        "sort-packages": true
    }
}
